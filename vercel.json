{
  "outputDirectory": "public",
  "functions": {
    "api/docs.js": {
      "maxDuration": 60,
      "includeFiles": "thesis-archive/**"
    },
    "api/draftcheck.js": {
      "maxDuration": 60,
      "includeFiles": "thesis-archive/**"
    },
    "api/ai.js": {
      "maxDuration": 60,
      "includeFiles": "thesis-archive/**"
    },
    "api/login.js": {
      "maxDuration": 60
    },
    "api/state.js": {
      "maxDuration": 60
    },
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}